+def replace_with_exact_audio(edl: dict, edit_dir: Path, base_path: Path) -> None:
+    """Rebuild the base audio straight from the sources, sample-exact per range.
+
+    Each AAC segment starts with ~21 ms of encoder priming and is cut to whole
+    AAC frames, so `-c copy` concat shifts the audio a little at every cut; with
+    hundreds of cuts the voice drifts seconds behind the picture. Here every
+    range gets exactly as many samples as its video frames last (boundaries
+    computed on the cumulative timeline, so rounding never accumulates).
+    """
+    from fractions import Fraction
+
+    sr = 48000
+    fps = Fraction(edl.get("fps", 24)).limit_denominator(1001)
+    wav_path = edit_dir / "_exact_audio.wav"
+    frames_done = 0
+    print("exact audio → rebuilding the soundtrack sample-exact per range")
+    with wave.open(str(wav_path), "wb") as wav:
+        wav.setnchannels(2)
+        wav.setsampwidth(2)
+        wav.setframerate(sr)
+        for r in edl["ranges"]:
+            src = resolve_path(edl["sources"][r["source"]], edit_dir)
+            n_frames = round((float(r["end"]) - float(r["start"])) * fps)
+            s0 = round(frames_done * sr / fps)
+            frames_done += n_frames
+            n = round(frames_done * sr / fps) - s0
+            dur = n / sr
+            af = f"afade=t=in:st=0:d=0.03,afade=t=out:st={max(0.0, dur - 0.03):.6f}:d=0.03"
+            pcm = subprocess.run(
+                ["ffmpeg", "-v", "error", "-ss", f"{float(r['start']):.6f}", "-i", str(src),
+                 "-t", f"{dur:.6f}", "-vn", "-af", af, "-ac", "2", "-ar", str(sr),
+                 "-f", "s16le", "pipe:1"],
+                check=True, capture_output=True,
+            ).stdout
+            wav.writeframes(pcm[: n * 4].ljust(n * 4, b"\0"))
+
+    tmp = base_path.with_name(base_path.stem + ".exactaudio.mp4")
+    run([
+        "ffmpeg", "-y", "-v", "error", "-i", str(base_path), "-i", str(wav_path),
+        "-map", "0:v:0", "-map", "1:a:0", "-c:v", "copy",
+        "-c:a", "aac", "-b:a", "192k", "-movflags", "+faststart", str(tmp),
+    ], quiet=True)
+    tmp.replace(base_path)
+    wav_path.unlink(missing_ok=True)
+
+
